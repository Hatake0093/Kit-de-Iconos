<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <FontFamily x:Key="Familia">Segoe UI</FontFamily>
    <sys:Double x:Key="Cuerpo">16</sys:Double>
    <sys:Double x:Key="TamTitulo">32</sys:Double>
    <Thickness x:Key="Separacion">0,0,0,8</Thickness>
    <Thickness x:Key="Interior">24</Thickness>
    <CornerRadius x:Key="Radio">8</CornerRadius>

    <Style x:Key="Titulo" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TamTitulo}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="{StaticResource Separacion}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Tarjeta" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Superficie}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Borde}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="{StaticResource Interior}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radio}"/>
    </Style>
    <Style x:Key="FocoTeclado" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" BorderThickness="2" BorderBrush="{DynamicResource Foco}"
                            CornerRadius="{StaticResource Radio}" IsHitTestVisible="False"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="AccionPrincipal" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Accion}"/>
        <Setter Property="Foreground" Value="{DynamicResource SobreAccion}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Borde}"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocoTeclado}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Marco" CornerRadius="{StaticResource Radio}"
                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="2" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Marco" Property="BorderBrush" Value="{DynamicResource SobreAccion}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Marco" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{DynamicResource Fondo}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
                            <Setter TargetName="Marco" Property="BorderBrush" Value="{DynamicResource Borde}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
